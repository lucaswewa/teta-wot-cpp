{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "teta-wot-cpp",
  "version": "0.1.0",
  "description": "W3C Web of Things Things served over HTTP with Drogon, with wire-level parity with teta-wot.",
  "license": "MIT",
  "dependencies": [
    {
      "name": "drogon",
      "default-features": false
    },
    "boost-pfr",
    "nlohmann-json",
    "re2",
    "tl-expected"
  ],
  "features": {
    "spdlog": {
      "description": "The spdlog sink (teta/wot/log_spdlog.hpp), used by the invocation-logs example",
      "dependencies": [
        "spdlog"
      ]
    },
    "tests": {
      "description": "Unit tests and fixture replay",
      "dependencies": [
        "gtest",
        "json-schema-validator"
      ]
    }
  }
}
