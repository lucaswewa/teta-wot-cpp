@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json 3.11 CONFIG)
find_dependency(boost_pfr CONFIG)
find_dependency(re2 CONFIG)
find_dependency(Threads)
find_dependency(tl-expected CONFIG)
if(@TETA_WOT_TD_VALIDATION@)
    find_dependency(nlohmann_json_schema_validator CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/teta-wot-targets.cmake")
check_required_components(teta-wot)
