nt_probe/ws\",\"op\":[\"subscribeevent\"]}],\"data\":{\"type\":\"integer\"}},\"happened\":{\"description\":\"Emitted by `happen`.\",\"title\":\"Something happened.\",\"forms\":[{\"href\":\"/event_probe/happened\",\"op\":[\"subscribeevent\",\"unsubscribeevent\"],\"subprotocol\":\"sse\"},{\"href\":\"ws://testserver/event_probe/ws\",\"op\":[\"subscribeevent\"]}],\"data\":{\"description\":\"What happened.\",\"type\":\"object\",\"properties\":{\"what\":{\"description\":\"What it was.\",\"type\":\"string\"},\"times\":{\"description\":\"How many times it happened.\",\"type\":\"integer\"}},\"required\":[\"what\",\"times\"]}}},\"description\":\"A Thing whose actions emit events.\",\"forms\":[{\"href\":\"/event_probe/properties\",\"op\":[\"readallproperties\",\"writemultipleproperties\"]},{\"href\":\"/event_probe/properties\",\"op\":[\"observeallproperties\",\"unobserveallproperties\"],\"subprotocol\":\"sse\"},{\"href\":\"/event_probe/actions\",\"op\":[\"queryallactions\"]},{\"href\":\"/event_probe/events\",\"op\":[\"subscribeallevents\",\"unsubscribeallevents\"],\"subprotocol\":\"sse\"}],\"base\":\"http://testserver/\",\"securityDefinitions\":{\"no_security\":{\"description\":\"No security\",\"scheme\":\"nosec\"}},\"security\":\"no_security\",\"@context\":\"https://www.w3.org/2022/wot/td/v1.1\"}"
