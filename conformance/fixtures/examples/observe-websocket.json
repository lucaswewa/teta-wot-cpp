          },
          "text": "{\"messageType\":\"actionStatus\",\"data\":{\"action name\":\"heat_to\",\"status\":\"completed\"}}"
        }
      ]
    },
    {
      "step": {
        "name": "safe_to_open",
        "method": "GET",
        "path": "/oven/safe_to_open"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "vary": "Origin"
        },
        "body": true,
        "text": "true"
      }
    },
    {
