        "text": "{\"status\":\"completed\",\"id\":\"<uuid:1>\",\"action\":\"/oven/heat_to\",\"href\":\"http://testserver/action_invocations/<uuid:1>\",\"timeStarted\":\"<naive-datetime>\",\"timeRequested\":\"<naive-datetime>\",\"timeCompleted\":\"<naive-datetime>\",\"links\":[{\"href\":\"http://testserver/action_invocations/<uuid:1>\",\"type\":null,\"rel\":\"self\",\"anchor\":null},{\"href\":\"http://testserver/action_invocations/<uuid:1>/output\",\"type\":null,\"rel\":\"output\",\"anchor\":null}],\"input\":{\"target\":40.0},\"output\":40.0,\"log\":[],\"error\":null}"
      }
    },
    {
      "step": {
        "name": "heating",
        "socket": "a",
        "receive": 5
      },
      "messages": [
