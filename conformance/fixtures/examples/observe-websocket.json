              "status": "running"
            }
          },
          "text": "{\"messageType\":\"actionStatus\",\"data\":{\"action name\":\"heat_to\",\"status\":\"running\"}}"
        },
        {
          "body": {
            "messageType": "propertyStatus",
            "data": {
              "temperature": 30.0
            }
          },
          "text": "{\"messageType\":\"propertyStatus\",\"data\":{\"temperature\":30.0}}"
        },
        {
          "body": {
            "messageType": "propertyStatus",
            "data": {
              "temperature": 40.0
