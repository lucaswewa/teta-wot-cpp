{
  "openapi": "3.1.0",
  "info": {
    "title": "Microscope",
    "version": "1.0.0"
  },
  "paths": {
    "/action_invocations": {
      "get": {
        "summary": "List All Invocations",
        "description": "Every invocation the server is keeping, of every action.",
        "operationId": "list_all_invocations_action_invocations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InvocationSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/action_invocations/{id}": {
      "get": {
        "summary": "Action Invocation",
        "description": "One invocation: its status, input, output, log and error.",
        "operationId": "action_invocation_action_invocations__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invocation"
                }
              }
            }
          },
          "404": {
            "description": "Invocation ID not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Invocation",
        "description": "Cancel an invocation (`cancelaction`). The action stops at its next cancellation check.",
        "operationId": "delete_invocation_action_invocations__id__delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancel request sent",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Invocation may not be cancelled"
          },
          "404": {
            "description": "Invocation ID not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/action_invocations/{id}/output": {
      "get": {
        "summary": "Action Invocation Output",
        "description": "The output of a completed invocation. When the output is a Blob, this is its data.",
        "operationId": "action_invocation_output_action_invocations__id__output_get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Action invocation output",
            "content": {
              "application/json": {
                "schema": {}
              },
              "*/*": {}
            }
          },
          "503": {
            "description": "No result is available for this invocation"
          },
          "404": {
            "description": "Invocation ID not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/blob/{blob_id}": {
      "get": {
        "summary": "Download Blob",
        "description": "A Blob's data, while an invocation or the Thing still holds it.",
        "operationId": "download_blob_blob__blob_id__get",
        "parameters": [
          {
            "name": "blob_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "*/*": {}
            }
          },
          "404": {
            "description": "Blob not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/thing_descriptions/": {
      "get": {
        "summary": "Thing Descriptions",
        "description": "The Thing Description of every Thing, by name.",
        "operationId": "thing_descriptions_thing_descriptions__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/ThingDescription"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/things/": {
      "get": {
        "summary": "Thing Paths",
        "description": "The URL of every Thing's Thing Description, by name.",
        "operationId": "thing_paths_things__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/wot": {
      "get": {
        "summary": "Thing Description Directory",
        "description": "The TD of this server's Thing Description Directory (W3C WoT Discovery).",
        "operationId": "well_known_wot__well_known_wot_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/td+json": {
                "schema": {
                  "$ref": "#/components/schemas/ThingDescription"
                }
              }
            }
          }
        }
      }
    },
    "/directory/things": {
      "get": {
        "summary": "Thing Descriptions",
        "description": "Every Thing's TD, sorted by `id`. With `limit`, a page, with `next` and `canonical` links.",
        "operationId": "directory_things_directory_things_get",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "How many TDs to skip",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many TDs in a page (at least 1)",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "array",
                "collection"
              ],
              "default": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/ld+json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ThingDescription"
                      }
                    },
                    {
                      "type": "object",
                      "description": "A ThingCollection"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid query arguments"
          }
        }
      }
    },
    "/directory/things/{id}": {
      "get": {
        "summary": "Thing Description",
        "description": "One TD, by its `id`.",
        "operationId": "directory_thing_directory_things__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "iri-reference"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/td+json": {
                "schema": {
                  "$ref": "#/components/schemas/ThingDescription"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No TD has this ID"
          }
        }
      }
    },
    "/stage/move_to": {
      "get": {
        "summary": "All invocations of move_to.",
        "description": "List all the invocations of move_to that the server is keeping, with their times and links.",
        "operationId": "list_invocations_stage_move_to_get",
        "responses": {
          "200": {
            "description": "A list of every invocation of move_to.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InvocationSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Move to a position.",
        "description": "## Move to a position.\n\nMove to a position.\n\n## Important note\n\nThis `POST` request starts an action: the server may carry on after answering. The answer is always a 201 with the invocation, whose `href` can be polled to follow it, and whose `output` link gives the result when it has completed.",
        "operationId": "start_action_stage_move_to_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/stage_move_to_input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Action has been invoked (and may still be running).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/stage_move_to_invocation"
                }
              }
            }
          },
          "200": {
            "description": "Action completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/stage_move_to_output"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stage/moved": {
      "get": {
        "summary": "The stage reached a new position.",
        "description": "## The stage reached a new position.\n\nThe stage reached a new position.\n\nServer-sent events: each event's data, as JSON in a `data:` line, following this schema:\n\n```json\n{\n  \"$ref\": \"#/components/schemas/stage_moved_data\"\n}\n```",
        "operationId": "subscribe_event_stage_moved_get",
        "responses": {
          "200": {
            "description": "Server-sent events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/stage/position": {
      "get": {
        "summary": "Where the stage is.",
        "description": "## Where the stage is.\n\nWhere the stage is.",
        "operationId": "get_property_stage_position_get",
        "responses": {
          "200": {
            "description": "Value of position",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/stage_position_value"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-sent events: each new value as JSON in a `data:` line. Ask for them with `Accept: text/event-stream`."
                }
              }
            }
          }
        }
      }
    },
    "/stage/properties": {
      "get": {
        "summary": "Read All Properties",
        "description": "Every property of `stage` (`readallproperties`), or their changes (`observeallproperties`).",
        "operationId": "read_all_properties_stage_properties_get",
