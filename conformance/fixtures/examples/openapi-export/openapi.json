  },
  "components": {
    "schemas": {
      "InvocationStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "completed",
          "cancelled",
          "error"
        ],
        "description": "Where an invocation is in its life."
      },
      "InvocationSummary": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/InvocationStatus"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "format": "uri"
          },
          "timeStarted": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "timeRequested": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "timeCompleted": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LinkElement"
            }
          }
        },
        "required": [
          "status",
          "id",
          "action",
          "href",
          "timeStarted",
          "timeRequested",
          "timeCompleted"
        ],
        "description": "An invocation, as lists show it."
      },
      "Invocation": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/InvocationStatus"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "format": "uri"
          },
          "timeStarted": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "timeRequested": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
