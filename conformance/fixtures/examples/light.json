    {
      "step": {
        "name": "status_on",
        "method": "GET",
        "path": "/light/status"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "vary": "Origin"
        },
        "body": "The light is on at 100% brightness.",
        "text": "\"The light is on at 100% brightness.\""
      }
    },
    {
      "step": {
        "name": "too_bright",
        "method": "PUT",
        "path": "/light/brightness",
        "json": 150
      },
      "response": {
        "status": 422,
        "headers": {
          "content-type": "application/json",
          "vary": "Origin"
        },
        "body": {
          "detail": [
            {
              "type": "less_than_equal",
              "loc": [
                "body"
              ],
              "msg": "Input should be less than or equal to 100",
              "input": 150,
              "ctx": {
                "le": 100
              }
            }
          ]
        },
        "text": "{\"detail\":[{\"type\":\"less_than_equal\",\"loc\":[\"body\"],\"msg\":\"Input should be less than or equal to 100\",\"input\":150,\"ctx\":{\"le\":100}}]}"
      }
    },
    {
      "step": {
        "name": "dim",
        "method": "PUT",
        "path": "/light/brightness",
        "json": 40
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json",
          "vary": "Origin"
        },
        "body": null,
        "text": "null"
      }
    },
    {
      "step": {
        "name": "status_dim",
        "method": "GET",
        "path": "/light/status"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "vary": "Origin"
        },
        "body": "The light is on at 40% brightness.",
        "text": "\"The light is on at 40% brightness.\""
      }
    },
    {
