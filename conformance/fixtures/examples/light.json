                    "description": "A model representing an object that must have no keys.",
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "output": {
                "title": "toggle_output",
                "type": "null"
              },
              "synchronous": false
            }
          },
          "description": "A computer-controlled light, our first example Thing.",
