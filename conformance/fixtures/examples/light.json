      "response": {
        "status": 405,
        "headers": {
          "content-type": "application/json",
          "allow": "GET",
          "vary": "Origin"
        },
        "body": {
          "detail": "Method Not Allowed"
        },
        "text": "{\"detail\":\"Method Not Allowed\"}"
      }
    },
    {
      "step": {
        "name": "write_status",
        "method": "PUT",
        "path": "/light/status",
        "json": "on"
      },
      "response": {
        "status": 405,
        "headers": {
          "content-type": "application/json",
          "allow": "GET",
          "vary": "Origin"
        },
        "body": {
          "detail": "Method Not Allowed"
        },
        "text": "{\"detail\":\"Method Not Allowed\"}"
      }
    },
    {
      "step": {
