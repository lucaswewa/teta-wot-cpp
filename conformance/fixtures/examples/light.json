            },
            {
              "href": "/light/actions",
              "op": [
                "queryallactions"
              ]
            }
          ],
          "base": "http://testserver/",
          "securityDefinitions": {
            "no_security": {
              "description": "No security",
              "scheme": "nosec"
            }
          },
          "security": "no_security",
          "@context": "https://www.w3.org/2022/wot/td/v1.1"
        },
        "text": "{\"id\":\"urn:uuid:<uuid:0>\",\"title\":\"Light\",\"properties\":{\"brightness\":{\"description\":\"The brightness of the light, in % of maximum.\",\"title\":\"The brightness of the light, in % of maximum.\",\"writeOnly\":false,\"readOnly\":false,\"default\":100,\"type\":\"integer\",\"minimum\":0,\"maximum\":100,\"forms\":[{\"href\":\"/light/brightness\",\"op\":[\"readproperty\",\"writeproperty\"]},{\"href\":\"/light/brightness\",\"op\":[\"observeproperty\",\"unobserveproperty\"],\"subprotocol\":\"sse\"},{\"href\":\"ws://testserver/light/ws\",\"op\":[\"observeproperty\"]}],\"observable\":true},\"is_on\":{\"description\":\"Whether the light is currently on.\",\"title\":\"Whether the light is currently on.\",\"writeOnly\":false,\"readOnly\":true,\"default\":false,\"type\":\"boolean\",\"forms\":[{\"href\":\"/light/is_on\",\"op\":[\"readproperty\"]},{\"href\":\"/light/is_on\",\"op\":[\"observeproperty\",\"unobserveproperty\"],\"subprotocol\":\"sse\"},{\"href\":\"ws://testserver/light/ws\",\"op\":[\"observeproperty\"]}],\"observable\":true},\"status\":{\"description\":\"A human-readable status of the light.\",\"title\":\"A human-readable status of the light.\",\"writeOnly\":false,\"readOnly\":true,\"type\":\"string\",\"forms\":[{\"href\":\"/light/status\",\"op\":[\"readproperty\"]}]}},\"actions\":{\"toggle\":{\"description\":\"Swap the light between on and off.\",\"title\":\"Swap the light between on and off.\",\"forms\":[{\"href\":\"/light/toggle\",\"op\":[\"invokeaction\"]},{\"href\":\"/action_invocations/{id}\",\"op\":[\"queryaction\",\"cancelaction\"]}],\"uriVariables\":{\"id\":{\"title\":\"Invocation ID\",\"format\":\"uuid\",\"type\":\"string\"}},\"input\":{\"description\":\"Represent the input of an action that never takes parameters.\\n\\nThis may be either an empty dictionary or ``None``.\",\"title\":\"toggle_input\",\"oneOf\":[{\"description\":\"A model representing an object that must have no keys.\",\"type\":\"object\",\"properties\":{},\"additionalProperties\":false},{\"type\":\"null\"}]},\"output\":{\"title\":\"toggle_output\",\"type\":\"null\"},\"synchronous\":false}},\"description\":\"A computer-controlled light, our first example Thing.\",\"forms\":[{\"href\":\"/light/properties\",\"op\":[\"readallproperties\",\"writemultipleproperties\"]},{\"href\":\"/light/properties\",\"op\":[\"observeallproperties\",\"unobserveallproperties\"],\"subprotocol\":\"sse\"},{\"href\":\"/light/actions\",\"op\":[\"queryallactions\"]}],\"base\":\"http://testserver/\",\"securityDefinitions\":{\"no_security\":{\"description\":\"No security\",\"scheme\":\"nosec\"}},\"security\":\"no_security\",\"@context\":\"https://www.w3.org/2022/wot/td/v1.1\"}"
      }
