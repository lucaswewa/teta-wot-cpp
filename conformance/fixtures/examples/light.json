        "body": {
          "id": "urn:uuid:<uuid:0>",
          "title": "Light",
          "properties": {
            "brightness": {
              "description": "The brightness of the light, in % of maximum.",
              "title": "The brightness of the light, in % of maximum.",
              "writeOnly": false,
              "readOnly": false,
              "default": 100,
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "forms": [
                {
                  "href": "/light/brightness",
                  "op": [
                    "readproperty",
                    "writeproperty"
                  ]
                },
                {
                  "href": "/light/brightness",
                  "op": [
                    "observeproperty",
                    "unobserveproperty"
                  ],
                  "subprotocol": "sse"
                },
                {
                  "href": "ws://testserver/light/ws",
                  "op": [
                    "observeproperty"
                  ]
                }
              ],
              "observable": true
            },
            "is_on": {
              "description": "Whether the light is currently on.",
              "title": "Whether the light is currently on.",
              "writeOnly": false,
              "readOnly": true,
              "default": false,
              "type": "boolean",
              "forms": [
                {
                  "href": "/light/is_on",
                  "op": [
                    "readproperty"
                  ]
                },
                {
                  "href": "/light/is_on",
                  "op": [
                    "observeproperty",
                    "unobserveproperty"
                  ],
                  "subprotocol": "sse"
                },
                {
                  "href": "ws://testserver/light/ws",
                  "op": [
                    "observeproperty"
                  ]
                }
              ],
              "observable": true
            },
            "status": {
              "description": "A human-readable status of the light.",
              "title": "A human-readable status of the light.",
              "writeOnly": false,
              "readOnly": true,
              "type": "string",
              "forms": [
                {
                  "href": "/light/status",
                  "op": [
                    "readproperty"
                  ]
                }
              ]
            }
          },
          "actions": {
