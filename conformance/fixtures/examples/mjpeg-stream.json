        "body": {
          "status": "<race>",
          "id": "<uuid:3>",
          "action": "/camera/sharpness",
          "href": "http://testserver/action_invocations/<uuid:3>",
          "timeStarted": "<race>",
          "timeRequested": "<naive-datetime>",
