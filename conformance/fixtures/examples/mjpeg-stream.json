          "id": "<uuid:1>",
          "action": "/camera/snapshot",
          "href": "http://testserver/action_invocations/<uuid:1>",
          "timeStarted": "<naive-datetime>",
          "timeRequested": "<naive-datetime>",
          "timeCompleted": "<naive-datetime>",
          "links": [
            {
              "href": "http://testserver/action_invocations/<uuid:1>",
              "type": null,
              "rel": "self",
              "anchor": null
            },
            {
              "href": "http://testserver/action_invocations/<uuid:1>/output",
              "type": null,
              "rel": "output",
              "anchor": null
            }
          ],
          "input": null,
          "output": {
            "href": "http://testserver/blob/<uuid:2>",
            "media_type": "image/jpeg",
            "rel": "output",
            "description": "The output from this action is not serialised to JSON, so it must be retrieved as a file. This link will return the file."
          },
          "log": [],
          "error": null
        },
        "text": "{\"status\":\"completed\",\"id\":\"<uuid:1>\",\"action\":\"/camera/snapshot\",\"href\":\"http://testserver/action_invocations/<uuid:1>\",\"timeStarted\":\"<naive-datetime>\",\"timeRequested\":\"<naive-datetime>\",\"timeCompleted\":\"<naive-datetime>\",\"links\":[{\"href\":\"http://testserver/action_invocations/<uuid:1>\",\"type\":null,\"rel\":\"self\",\"anchor\":null},{\"href\":\"http://testserver/action_invocations/<uuid:1>/output\",\"type\":null,\"rel\":\"output\",\"anchor\":null}],\"input\":null,\"output\":{\"href\":\"http://testserver/blob/<uuid:2>\",\"media_type\":\"image/jpeg\",\"rel\":\"output\",\"description\":\"The output from this action is not serialised to JSON, so it must be retrieved as a file. This link will return the file.\"},\"log\":[],\"error\":null}"
      }
    },
    {
      "step": {
        "name": "snapshot_output",
        "method": "GET",
        "path": "/action_invocations/{last}/output",
        "ignore_body": true
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "image/jpeg",
          "vary": "Origin"
