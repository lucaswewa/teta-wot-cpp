{
  "config": {
    "things": {
      "settings_probe": "twins.settings_probe:SettingsProbe"
    },
    "server_id": "conformance"
  },
  "steps": [
    {"name": "no_file_before_a_change", "file": "settings_probe/Settings-SettingsProbe.json"},
    {"name": "read_count_default", "method": "GET", "path": "/settings_probe/count"},
    {"name": "read_exposure_default", "method": "GET", "path": "/settings_probe/exposure"},
    {"name": "write_count", "method": "PUT", "path": "/settings_probe/count", "json": 3},
    {"name": "saved_after_the_first_write", "file": "settings_probe/Settings-SettingsProbe.json"},
    {"name": "write_ratio_small", "method": "PUT", "path": "/settings_probe/ratio", "json": 1e-7},
    {"name": "write_label", "method": "PUT", "path": "/settings_probe/label", "json": "µm 中文 \"q\" \\ \u0001 😀"},
    {"name": "write_enabled", "method": "PUT", "path": "/settings_probe/enabled", "json": "yes"},
    {"name": "write_tags", "method": "PUT", "path": "/settings_probe/tags", "json": ["a", "b", ""]},
    {"name": "write_limits", "method": "PUT", "path": "/settings_probe/limits", "json": {"low": 1e-5, "high": 1e20, "mid": 0.1, "zero": 0}},
    {"name": "write_calibration", "method": "PUT", "path": "/settings_probe/calibration", "json": {"offset": 0.5, "gain": 2}},
    {"name": "write_maybe", "method": "PUT", "path": "/settings_probe/maybe", "json": 7},
    {"name": "write_exposure", "method": "PUT", "path": "/settings_probe/exposure", "json": 12.5},
    {"name": "every_setting_saved", "file": "settings_probe/Settings-SettingsProbe.json"},
    {"name": "write_count_invalid", "method": "PUT", "path": "/settings_probe/count", "json": -1},
    {"name": "write_exposure_invalid", "method": "PUT", "path": "/settings_probe/exposure", "json": "bright"},
    {"name": "unchanged_after_refused_writes", "file": "settings_probe/Settings-SettingsProbe.json"},
    {"name": "write_several", "method": "PUT", "path": "/settings_probe/properties", "json": {"count": 4, "ratio": 2.5}},
    {"name": "saved_after_writing_several", "file": "settings_probe/Settings-SettingsProbe.json"},
    {"name": "reset_maybe", "method": "POST", "path": "/settings_probe/maybe/reset"},
    {"name": "saved_after_a_reset", "file": "settings_probe/Settings-SettingsProbe.json"},
    {"name": "restart", "restart": true},
    {"name": "no_warnings", "warnings": true},
    {"name": "loaded", "method": "GET", "path": "/settings_probe/properties"},
    {"name": "loaded_exposure", "method": "GET", "path": "/settings_probe/exposure"},
    {"name": "not_rewritten_by_loading", "file": "settings_probe/Settings-SettingsProbe.json"},
    {"name": "hand_edit", "write_file": "settings_probe/Settings-SettingsProbe.json", "text": "{\r\n  \"count\": -5, \"label\": 5, \"lamp\": \"on\",\r\n  \"ratio\": \"0.75\", \"maybe\": null, \"exposure\": \"15\",\r\n  \"calibration\": {\"offset\": 1}, \"tags\": \"x\"\r\n}\r\n"},
    {"name": "restart_after_hand_edit", "restart": true},
    {"name": "hand_edit_warnings", "warnings": true},
    {"name": "loaded_after_hand_edit", "method": "GET", "path": "/settings_probe/properties"},
    {"name": "loaded_exposure_after_hand_edit", "method": "GET", "path": "/settings_probe/exposure"},
    {"name": "hand_edit_kept_until_saved", "file": "settings_probe/Settings-SettingsProbe.json"},
    {"name": "write_enabled_again", "method": "PUT", "path": "/settings_probe/enabled", "json": false},
    {"name": "rewritten_without_the_extra_key", "file": "settings_probe/Settings-SettingsProbe.json"},
    {"name": "not_a_mapping", "write_file": "settings_probe/Settings-SettingsProbe.json", "text": "[1, 2]"},
    {"name": "restart_with_a_list", "restart": true},
    {"name": "list_warnings", "warnings": true},
    {"name": "defaults_after_a_list", "method": "GET", "path": "/settings_probe/properties"},
    {"name": "not_json", "write_file": "settings_probe/Settings-SettingsProbe.json", "text": "{\"count\": "},
    {"name": "restart_with_bad_json", "restart": true},
    {"name": "bad_json_warnings", "warnings": true},
    {"name": "defaults_after_bad_json", "method": "GET", "path": "/settings_probe/properties"},
    {"name": "bad_json_kept_until_saved", "file": "settings_probe/Settings-SettingsProbe.json"},
    {"name": "write_count_after_bad_json", "method": "PUT", "path": "/settings_probe/count", "json": 9},
    {"name": "rewritten_after_bad_json", "file": "settings_probe/Settings-SettingsProbe.json"},
    {"name": "empty_object", "write_file": "settings_probe/Settings-SettingsProbe.json", "text": "{}"},
    {"name": "restart_with_an_empty_object", "restart": true},
    {"name": "empty_object_warnings", "warnings": true},
    {"name": "defaults_after_an_empty_object", "method": "GET", "path": "/settings_probe/properties"}
  ]
}
