{
  "config": {
    "things": {
      "counter": "twins.counter:TestThing",
      "http_probe": "twins.http_probe:HttpProbe",
      "event_probe": "twins.event_probe:EventProbe"
    },
    "security": {
      "scheme": "basic",
      "username": "lab",
      "password_env": "TETA_WOT_TEST_PASSWORD"
    },
    "server_id": "conformance"
  },
  "env": {
    "TETA_WOT_TEST_PASSWORD": "open sesame"
  },
  "steps": [
    {
      "name": "td",
      "method": "GET",
      "path": "/counter/"
    },
    {
      "name": "things",
      "method": "GET",
      "path": "/things/"
    },
    {
      "name": "thing_descriptions",
      "method": "GET",
      "path": "/thing_descriptions/"
    },
    {
      "name": "openapi",
      "method": "GET",
      "path": "/openapi.json"
    },
    {
      "name": "docs",
      "method": "GET",
      "path": "/docs"
    },
    {
      "name": "well_known",
      "method": "GET",
      "path": "/.well-known/wot"
    },
    {
      "name": "directory",
      "method": "GET",
      "path": "/directory/things"
    },
    {
      "name": "read_anonymous",
      "method": "GET",
      "path": "/counter/counter"
    },
    {
      "name": "read_wrong_scheme",
      "method": "GET",
      "path": "/counter/counter",
      "headers": {
        "Authorization": "Bearer open sesame"
      }
    },
    {
      "name": "read_garbage",
      "method": "GET",
      "path": "/counter/counter",
      "headers": {
        "Authorization": "nonsense"
      }
    },
    {
      "name": "read",
      "method": "GET",
      "path": "/counter/counter",
      "headers": {
        "Authorization": "Basic bGFiOm9wZW4gc2VzYW1l"
      }
    },
    {
      "name": "read_lower_case",
      "method": "GET",
      "path": "/counter/counter",
      "headers": {
        "Authorization": "basic bGFiOm9wZW4gc2VzYW1l"
      }
    },
    {
      "name": "read_padded",
      "method": "GET",
      "path": "/counter/counter",
      "headers": {
        "Authorization": "  Basic   bGFiOm9wZW4gc2VzYW1l  "
      }
    },
    {
      "name": "write_anonymous",
      "method": "PUT",
      "path": "/http_probe/value",
      "json": 3
    },
    {
      "name": "write",
      "method": "PUT",
      "path": "/http_probe/value",
      "json": 3,
      "headers": {
        "Authorization": "Basic bGFiOm9wZW4gc2VzYW1l"
      }
    },
    {
      "name": "invoke_anonymous",
      "method": "POST",
      "path": "/counter/increment_counter"
    },
    {
      "name": "invoke",
      "method": "POST",
      "path": "/counter/increment_counter",
      "headers": {
        "Authorization": "Basic bGFiOm9wZW4gc2VzYW1l"
      },
      "wait": true
    },
    {
      "name": "invocations_anonymous",
      "method": "GET",
      "path": "/action_invocations"
    },
    {
      "name": "invocations",
      "method": "GET",
      "path": "/action_invocations",
      "headers": {
        "Authorization": "Basic bGFiOm9wZW4gc2VzYW1l"
      }
    },
    {
      "name": "missing_anonymous",
      "method": "GET",
      "path": "/nope"
    },
    {
      "name": "wrong_method_anonymous",
      "method": "DELETE",
      "path": "/counter/counter"
    },
    {
      "name": "redirect_anonymous",
      "method": "GET",
      "path": "/counter"
    },
    {
      "name": "events_anonymous",
      "events": "/event_probe/happened",
      "stream": "a"
    },
    {
      "name": "websocket_anonymous",
      "websocket": "/event_probe/ws",
      "socket": "x"
    },
    {
      "name": "websocket",
      "websocket": "/event_probe/ws",
      "socket": "y",
      "headers": {
        "Authorization": "Basic bGFiOm9wZW4gc2VzYW1l"
      }
    },
    {
      "name": "observe",
      "socket": "y",
      "send": {
        "messageType": "addPropertyObservation",
        "data": {
          "level": true
        }
      }
    },
    {
      "name": "write_level",
      "method": "PUT",
      "path": "/event_probe/level",
      "json": 2,
      "headers": {
        "Authorization": "Basic bGFiOm9wZW4gc2VzYW1l"
      }
    },
    {
      "name": "level",
      "socket": "y",
      "receive": 1
    }
  ]
}
