{
  "config": {
    "things": {
      "blob_probe": "twins.blob_probe:BlobProbe"
    },
    "server_id": "conformance"
  },
  "steps": [
    {"name": "td", "method": "GET", "path": "/blob_probe/"},
    {"name": "capture", "method": "POST", "path": "/blob_probe/capture", "wait": true},
    {"name": "capture_invocation", "method": "GET", "path": "/action_invocations/{last}"},
    {"name": "capture_output", "method": "GET", "path": "/action_invocations/{last}/output"},
    {"name": "capture_download", "method": "GET", "path": "/blob/{blob:0}"},
    {"name": "capture_to_file", "method": "POST", "path": "/blob_probe/capture_to_file", "wait": true},
    {"name": "capture_to_file_output", "method": "GET", "path": "/action_invocations/{last}/output"},
    {"name": "capture_to_file_download", "method": "GET", "path": "/blob/{blob:1}"},
    {"name": "text", "method": "POST", "path": "/blob_probe/text", "wait": true},
    {"name": "text_output", "method": "GET", "path": "/action_invocations/{last}/output"},
    {"name": "text_download", "method": "GET", "path": "/blob/{blob:2}"},
    {"name": "csv", "method": "POST", "path": "/blob_probe/csv", "wait": true},
    {"name": "csv_output", "method": "GET", "path": "/action_invocations/{last}/output"},
    {"name": "two_texts", "method": "POST", "path": "/blob_probe/two_texts", "wait": true},
    {"name": "two_texts_output", "method": "GET", "path": "/action_invocations/{last}/output"},
    {"name": "first_download", "method": "GET", "path": "/blob/{blob:4}"},
    {"name": "second_download", "method": "GET", "path": "/blob/{blob:5}"},
    {"name": "invocations", "method": "GET", "path": "/action_invocations"},
    {"name": "download_head", "method": "HEAD", "path": "/blob/{blob:2}"},
    {"name": "download_post", "method": "POST", "path": "/blob/{blob:2}"},
    {"name": "download_unknown", "method": "GET", "path": "/blob/00000000-0000-0000-0000-000000000000"},
    {"name": "download_not_a_uuid", "method": "GET", "path": "/blob/not-a-uuid"},
    {"name": "download_simple_uuid", "method": "GET", "path": "/blob/0123456789abcdef0123456789abcdef"},
    {"name": "passthrough", "method": "POST", "path": "/blob_probe/passthrough",
     "json": {"blob": {"href": "http://testserver/blob/{blob:2}", "media_type": "text/plain"}}, "wait": true},
    {"name": "passthrough_output", "method": "GET", "path": "/action_invocations/{last}/output"},
    {"name": "passthrough_elsewhere", "method": "POST", "path": "/blob_probe/passthrough",
     "json": {"blob": {"href": "https://elsewhere.example/api/blob/{blob:4}", "media_type": "text/plain", "rel": "output", "extra": 1}}, "wait": true},
    {"name": "passthrough_relative", "method": "POST", "path": "/blob_probe/passthrough",
     "json": {"blob": {"href": "blob/{blob:5}", "media_type": "text/plain"}}, "wait": true},
    {"name": "passthrough_vague", "method": "POST", "path": "/blob_probe/passthrough",
     "json": {"blob": {"href": "blob/{blob:3}", "media_type": "text/plain"}}},
    {"name": "passthrough_jpeg", "method": "POST", "path": "/blob_probe/passthrough",
     "json": {"blob": {"href": "blob/{blob:0}", "media_type": "text/plain"}}},
    {"name": "passthrough_wrong_media_type", "method": "POST", "path": "/blob_probe/passthrough",
     "json": {"blob": {"href": "blob/{blob:2}", "media_type": "image/jpeg"}}},
    {"name": "passthrough_unknown", "method": "POST", "path": "/blob_probe/passthrough",
     "json": {"blob": {"href": "http://testserver/blob/00000000-0000-0000-0000-000000000000", "media_type": "text/plain"}}},
    {"name": "passthrough_bad_uuid", "method": "POST", "path": "/blob_probe/passthrough",
     "json": {"blob": {"href": "http://testserver/blob/zzz", "media_type": "text/plain"}}},
    {"name": "passthrough_no_id", "method": "POST", "path": "/blob_probe/passthrough",
     "json": {"blob": {"href": "http://testserver/elsewhere", "media_type": "text/plain"}}},
    {"name": "passthrough_no_media_type", "method": "POST", "path": "/blob_probe/passthrough",
     "json": {"blob": {"href": "blob/{blob:2}"}}},
    {"name": "passthrough_empty", "method": "POST", "path": "/blob_probe/passthrough", "json": {"blob": {}}},
    {"name": "passthrough_number_href", "method": "POST", "path": "/blob_probe/passthrough",
     "json": {"blob": {"href": 5, "media_type": "text/plain"}}},
    {"name": "passthrough_string", "method": "POST", "path": "/blob_probe/passthrough", "json": {"blob": "blob/{blob:2}"}},
    {"name": "passthrough_list", "method": "POST", "path": "/blob_probe/passthrough", "json": {"blob": ["blob/{blob:2}", "text/plain"]}},
    {"name": "passthrough_missing", "method": "POST", "path": "/blob_probe/passthrough", "json": {}},
    {"name": "jpeg_size", "method": "POST", "path": "/blob_probe/jpeg_size",
     "json": {"image": {"href": "http://testserver/blob/{blob:1}", "media_type": "image/jpeg"}}, "wait": true},
    {"name": "jpeg_size_text", "method": "POST", "path": "/blob_probe/jpeg_size",
     "json": {"image": {"href": "blob/{blob:2}", "media_type": "image/jpeg"}}}
  ]
}
