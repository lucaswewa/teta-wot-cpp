{
  "config": {
    "things": {
      "stage": "microscope.stage:Stage",
      "camera": "microscope.camera:Camera",
      "autofocus": "microscope.autofocus:Autofocus"
    }
  },
  "steps": [
    {"name": "openapi", "method": "GET", "path": "/openapi.json"},
    {"name": "td_stage", "method": "GET", "path": "/stage/"},
    {"name": "td_camera", "method": "GET", "path": "/camera/"},
    {"name": "td_autofocus", "method": "GET", "path": "/autofocus/"},
    {"name": "position", "method": "GET", "path": "/stage/position"},
    {"name": "speed", "method": "GET", "path": "/stage/speed"},
    {"name": "last_focus_none", "method": "GET", "path": "/autofocus/last_focus"},
    {"name": "arrivals", "events": "/stage/arrived", "stream": "arrived"},
    {"name": "move_to", "method": "POST", "path": "/stage/move_to", "json": {"x": 400, "y": 200, "z": 0}, "wait": true},
    {"name": "arrived", "stream": "arrived", "receive": 1},
    {"name": "moved", "method": "GET", "path": "/stage/position"},
    {"name": "move_by", "method": "POST", "path": "/stage/move_by", "json": {"dz": 10}, "wait": true},
    {"name": "move_by_back", "method": "POST", "path": "/stage/move_by", "json": {"dz": -10}, "wait": true},
    {"name": "move_to_missing", "method": "POST", "path": "/stage/move_to", "json": {"x": 1}},
    {"name": "move_to_not_an_integer", "method": "POST", "path": "/stage/move_to", "json": {"x": 1.5, "y": 0, "z": 0}},
    {"name": "blurred", "method": "GET", "path": "/camera/sharpness"},
    {"name": "write_sharpness", "method": "PUT", "path": "/camera/sharpness", "json": 1.0},
    {"name": "write_position", "method": "PUT", "path": "/stage/position", "json": {"x": 0, "y": 0, "z": 0}},
    {"name": "too_slow", "method": "PUT", "path": "/stage/speed", "json": 0},
    {"name": "too_fast", "method": "PUT", "path": "/camera/fps", "json": 31},
    {"name": "too_long", "method": "PUT", "path": "/camera/exposure", "json": 1001},
    {"name": "settings_before", "file": "camera/Settings-Camera.json"},
    {"name": "exposure", "method": "PUT", "path": "/camera/exposure", "json": 30.0},
    {"name": "exposure_read", "method": "GET", "path": "/camera/exposure"},
    {"name": "settings_after", "file": "camera/Settings-Camera.json"},
    {"name": "stage_settings", "file": "stage/Settings-Stage.json"},
    {"name": "focus_events", "events": "/autofocus/focused", "stream": "focused"},
    {"name": "run", "method": "POST", "path": "/autofocus/run", "json": {"range": 1000, "steps": 21}, "wait": true},
    {"name": "focused", "stream": "focused", "receive": 1},
    {"name": "last_focus", "method": "GET", "path": "/autofocus/last_focus"},
    {"name": "focus_position", "method": "GET", "path": "/stage/position"},
    {"name": "sharp", "method": "GET", "path": "/camera/sharpness"},
    {"name": "camera_properties", "method": "GET", "path": "/camera/properties"},
    {"name": "run_few_steps", "method": "POST", "path": "/autofocus/run", "json": {"range": 100, "steps": 1}, "wait": true},
    {"name": "capture", "method": "POST", "path": "/camera/capture", "wait": true},
    {"name": "capture_download", "method": "GET", "path": "/blob/{blob:0}", "ignore_body": true},
    {"name": "preview", "mjpeg": "/camera/preview", "stream": "preview"},
    {"name": "preview_frames", "stream": "preview", "frames": 2, "ignore_body": true},
    {"name": "viewer", "method": "GET", "path": "/camera/preview/viewer"},
    {"name": "home", "method": "POST", "path": "/stage/home", "wait": true},
    {"name": "far", "method": "POST", "path": "/stage/move_to", "json": {"x": 100000, "y": 0, "z": 0}},
    {"name": "cancel", "method": "DELETE", "path": "/action_invocations/{last}"},
    {"name": "cancelled", "method": "GET", "path": "/action_invocations/{last}", "poll": true}
  ]
}
