{
  "serve": ["--serve"],
  "port": 5000,
  "steps": [
    {"name": "openapi", "method": "GET", "path": "/openapi.json"},
    {"name": "td", "method": "GET", "path": "/lamp/"},
    {"name": "docs", "method": "GET", "path": "/docs"},
    {"name": "redoc", "method": "GET", "path": "/redoc"},
    {"name": "oauth2_redirect", "method": "GET", "path": "/docs/oauth2-redirect"},
    {"name": "bundle", "method": "GET", "path": "/docs/swagger-ui-bundle.js", "ignore_body": true},
    {"name": "bundle_head", "method": "HEAD", "path": "/docs/swagger-ui-bundle.js"},
    {"name": "bundle_post", "method": "POST", "path": "/docs/swagger-ui-bundle.js"},
    {"name": "css", "method": "GET", "path": "/docs/swagger-ui.css", "ignore_body": true},
    {"name": "favicon", "method": "GET", "path": "/docs/favicon-32x32.png"},
    {"name": "redoc_bundle", "method": "GET", "path": "/redoc/redoc.standalone.js", "ignore_body": true},
    {"name": "unknown_asset", "method": "GET", "path": "/docs/nope.js"},
    {"name": "brightness", "method": "PUT", "path": "/lamp/brightness", "json": 101},
    {"name": "switch_off", "method": "POST", "path": "/lamp/switch_off", "wait": true},
    {"name": "brightness_after", "method": "GET", "path": "/lamp/brightness"}
  ]
}
