{
  "serve": [
    "--serve"
  ],
  "port": 5000,
  "steps": [
    {
      "name": "openapi",
      "method": "GET",
      "path": "/openapi.json"
    },
    {
      "name": "td",
      "method": "GET",
      "path": "/thermometer/"
    },
    {
      "name": "stream",
      "events": "/thermometer/temperature",
      "stream": "t"
    }
  ]
}
