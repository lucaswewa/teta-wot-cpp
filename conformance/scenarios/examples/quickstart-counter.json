{
  "serve": ["--serve"],
  "port": 5000,
  "steps": [
    {"name": "openapi", "method": "GET", "path": "/openapi.json"},
    {"name": "things", "method": "GET", "path": "/things/"},
    {"name": "td", "method": "GET", "path": "/counter/"},
    {"name": "read", "method": "GET", "path": "/counter/counter"},
    {"name": "write_readonly", "method": "PUT", "path": "/counter/counter", "json": 5},
    {"name": "invoke", "method": "POST", "path": "/counter/increment_counter", "wait": true},
    {"name": "read_after", "method": "GET", "path": "/counter/counter"},
    {"name": "invoke_slowly", "method": "POST", "path": "/counter/slowly_increase_counter"},
    {"name": "slowly_running", "method": "GET", "path": "/action_invocations/{last}", "poll": true, "until": ["running"]},
    {"name": "cancel_slowly", "method": "DELETE", "path": "/action_invocations/{last}"},
    {"name": "slowly_cancelled", "method": "GET", "path": "/action_invocations/{last}", "poll": true},
    {"name": "list", "method": "GET", "path": "/action_invocations"}
  ]
}
